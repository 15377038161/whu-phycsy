# 预览环境配置（当前沙箱/临时 HTTP 演示）。
# 使用 SQLite，无需外部 PostgreSQL，可直接启动；接入生产库后改用 .env.production。
APP_ENV=preview

# 预览模式允许浏览器在 HTTP 下保存登录会话（不启用 Secure Cookie / 不开启 Debug）
FLASK_SECRET_KEY=preview-with-a-long-random-secret-change-me

# SQLite 预览库（相对 Flask 项目根）
DATABASE_URL=sqlite:///runtime/platform.db
DATA_DIR=runtime

# 对外监听端口：平台通过 DEPLOY_RUN_PORT 注入，脚本自动读取；无需在此设置。

# 运行日志级别：debug | info | warning | error
LOG_LEVEL=debug

# ---- AI 服务（预览可暂空，未配置时 /ready 的 ai 项为 false，不影响页面） ----
AI_BASE_URL=
AI_API_KEY=
AI_TEXT_MODEL=
AI_VISION_MODEL=

# ---- 浏览器 Pyodide 静态镜像（可指向校内 HTTPS 镜像，需以 / 结尾） ----
PYODIDE_BASE_URL=https://cdn.jsdelivr.net/pyodide/v0.27.7/full/