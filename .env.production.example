# 生产环境配置模板。复制为 .env.production 并填写真实敏感值；严禁提交到版本库。
APP_ENV=production

# 生产强制启用 Secure Cookie 与一年 HSTS；必须使用强随机密钥（>=32 字节）。
FLASK_SECRET_KEY=replace-with-at-least-32-random-bytes

# ---- PostgreSQL（生产必需，SQLAlchemy 连接串）----
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/wuda_quantum
DATA_DIR=/var/lib/wuda-quantum/data

# 运行日志级别：info（生产建议）| debug | warning | error
LOG_LEVEL=info

# ---- 初始管理员 / 数据库凭据（仅供一次性初始化使用）----
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=replace-with-a-strong-initial-admin-password

# ---- AI 服务（实现方为任意 OpenAI 兼容 /v1 端点）----
AI_BASE_URL=https://your-openai-compatible-endpoint/v1
AI_API_KEY=replace-with-customer-ai-key
AI_TEXT_MODEL=your-text-model
AI_VISION_MODEL=your-vision-model
AI_READY_TTL_SECONDS=300

# 上传大小上限（MB）与浏览器 Pyodide 静态镜像
MAX_UPLOAD_MB=500
PYODIDE_BASE_URL=https://your-school-static-mirror/pyodide/v0.27.7/full/

# 镜像构建期参数（不影响应用运行环境）
PIP_INDEX_URL=https://pypi.org/simple
PIP_DEFAULT_TIMEOUT=120